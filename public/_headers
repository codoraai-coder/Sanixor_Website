# ═══════════════════════════════════════════════════════════════════════
#  Security headers — Cloudflare Workers static assets
# ═══════════════════════════════════════════════════════════════════════
#
# Built from the ACTUAL resource inventory, not from a template:
#
#   • scripts    — our own bundle, plus Razorpay's checkout, which is loaded
#                  only when someone chooses to pay.
#   • styles     — our own bundle, plus inline <style> blocks. Several
#                  components (Footer, AgentVerse2, BookDemoModal) ship
#                  their CSS in inline <style> elements, so 'unsafe-inline'
#                  is genuinely required for style-src today. Stated here
#                  rather than hidden: it is a real weakening of the policy,
#                  and removing it means moving that CSS into the bundle.
#   • fonts      — 'self' only. Typefaces are self-hosted, so no third-party
#                  font origin is needed at all.
#   • connect    — our own API, plus Razorpay's API for checkout.
#   • frames     — Razorpay's checkout iframe only.
#   • objects    — none. There is no plugin content on this site.
#
# NOTE: `Content-Security-Policy-Report-Only` is set first, deliberately.
# Deploy in report-only, watch for violations, and only then swap the header
# name to `Content-Security-Policy`. Enforcing a CSP you have not observed
# is how a payment flow breaks silently in production.

/*
  # ── Content Security Policy — REPORT ONLY until observed ──
  # To enforce: rename this header to `Content-Security-Policy`.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.razorpay.com; connect-src 'self' https://api.sanixor.space https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

  # ── Capability restrictions ──
  # Only `payment` is allowed, and only to ourselves, because Razorpay
  # checkout may use the Payment Request API. Everything else is denied:
  # this site has no need for a camera, a microphone or a location.
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(self), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), bluetooth=(), xr-spatial-tracking=()

  # ── Transport ──
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # ── Standard hardening ──
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Self-hosted fonts are immutable and content-hashed by the build, so they
# can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The disclosure document must not be cached aggressively — it carries an
# expiry date that has to stay current.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
